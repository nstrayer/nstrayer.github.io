---
import { SITE_CONFIG } from '../data/constants';
import Background from '../components/Background.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Nick Strayer’s personal website and portfolio.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f1e9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body id="top">
    <a class="skip-link" href="#content">Skip to content</a>
    <Background />
    <div class:list={['site-opening', { 'site-opening--full': Astro.slots.has('intro') }]}>
      <header class="site-header page-width">
        <div class="site-header-inner">
          <a class="site-name" href="/">{SITE_CONFIG.name}</a>
          <p class="site-role">{SITE_CONFIG.title}</p>
        </div>
      </header>
      <slot name="intro" />
    </div>
    <slot />
    <footer class="site-footer page-width">
      <div class="site-footer-inner">
        <p>&copy; {new Date().getFullYear()} {SITE_CONFIG.name}</p>
        <a class="text-link" href="#top">Back to top <span aria-hidden="true">↑</span></a>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-opening--full {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }

  @media print {
    .site-opening--full { min-height: auto; }
  }
</style>
