---
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';
import { marked } from 'marked';
import { Image } from 'astro:assets';

type Props = Project;
const { title, link, photo, github, description, caption, category } = Astro.props;
const parsedDescription = description.map(desc => marked.parseInline(desc, { async: false }));
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../public/**/*.{png,jpg,jpeg,webp,gif}', { eager: true }
);
const localImage = typeof photo === 'string'
  ? localImages[`../../public${photo}`]?.default
  : photo;
---

<article class:list={['project-entry', { 'project-without-image': !photo }]}>
  <header class="project-header">
    {category && <p class="project-category">{category}</p>}
    <h3>{title.trim()}</h3>
  </header>
  {photo && (
    <figure class="project-figure">
      {localImage && localImage.format !== 'gif' ? (
        <Image
          src={localImage}
          alt={title.trim()}
          width={Math.min(864, localImage.width)}
          widths={[256, 320, 576, 864].filter(width => width <= localImage.width)}
          sizes="(max-width: 700px) 22rem, 18rem"
          quality={80}
          class="project-image"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <img
          src={typeof photo === 'string' ? photo : photo.src}
          alt={title.trim()}
          width={localImage?.width}
          height={localImage?.height}
          class="project-image"
          loading="lazy"
          decoding="async"
        />
      )}
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )}
  <div class="project-body">
    <div class="project-description">
      {parsedDescription.map(html => <p set:html={html} />)}
    </div>
    {(link || github) && (
      <div class="link-row project-links">
        {link && <a href={link} target="_blank" rel="noopener noreferrer" class="text-link">View project <span aria-hidden="true">↗</span></a>}
        {github && <a href={github} target="_blank" rel="noopener noreferrer" class="text-link">Source code <span aria-hidden="true">↗</span></a>}
      </div>
    )}
  </div>
</article>

<style>
  /* The markup follows the phone reading order: title, image, then text. On wider
     screens, grid areas move the image into its own column beside the title and text,
     and the shorter of the two is centered against the taller one: the image beside
     long text, or the text (between the two flexible rows) beside a tall image. */
  .project-entry {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    grid-template-rows: 1fr auto auto 1fr;
    grid-template-areas: 'figure .' 'figure header' 'figure body' 'figure .';
    align-items: start;
    column-gap: 2rem;
  }
  .project-entry + .project-entry { border-top: 1px solid var(--rule-faint); padding-top: 1.75rem; }
  .project-without-image { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-template-areas: 'header' 'body'; }
  .project-header { grid-area: header; min-width: 0; }
  .project-figure { grid-area: figure; align-self: center; min-width: 0; max-width: 18rem; margin: 0; }
  .project-body { grid-area: body; min-width: 0; }
  /* Images narrower than their column sit centered in it, with the caption beneath. */
  .project-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 12rem;
    margin-inline: auto;
    object-fit: contain;
    object-position: top;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  figcaption { margin-top: 0.625rem; text-align: center; font-size: var(--text-caption); line-height: var(--leading-small); color: var(--muted-foreground); }
  .project-category { margin-bottom: 0.625rem; font-size: var(--text-caption); color: var(--muted-foreground); }
  h3 { font-size: var(--text-h3); margin-bottom: 0.75rem; }
  .project-description { max-width: 65ch; }
  .project-description > p + p { margin-top: 0.5rem; }
  .project-links { margin-top: 0.75rem; }

  /* Phones: the title leads, the image spans the column, and the points read as a
     list with the navigation's small muted dots. */
  @media (max-width: 700px) {
    .project-entry { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-template-areas: 'header' 'figure' 'body'; }
    .project-without-image { grid-template-areas: 'header' 'body'; }
    .project-category { margin-bottom: 0.375rem; }
    h3 { margin-bottom: 1rem; }
    .project-figure { max-width: none; margin-bottom: 1.25rem; }
    .project-image { max-height: 13rem; }
    .project-description > p { position: relative; padding-left: 1.125rem; }
    .project-description > p::before {
      content: '';
      position: absolute;
      top: 0.72em;
      left: 0.25rem;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.55;
    }
  }
</style>
