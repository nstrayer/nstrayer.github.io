---
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';
import { marked } from 'marked';
import { Image } from 'astro:assets';

type Props = Project;
const { title, link, photo, github, description, caption, category } = Astro.props;
const parsedDescription = description.map(desc => marked.parseInline(desc, { async: false }));
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../public/**/*.{png,jpg,jpeg,webp,gif}', { eager: true }
);
const localImage = typeof photo === 'string'
  ? localImages[`../../public${photo}`]?.default
  : photo;
---

<article class:list={['project-entry', { 'project-without-image': !photo }]}>
  {photo && (
    <figure class="project-figure">
      {localImage && localImage.format !== 'gif' ? (
        <Image
          src={localImage}
          alt={title.trim()}
          width={Math.min(864, localImage.width)}
          widths={[256, 320, 576, 864].filter(width => width <= localImage.width)}
          sizes="(max-width: 700px) 256px, 288px"
          quality={80}
          class="project-image"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <img
          src={typeof photo === 'string' ? photo : photo.src}
          alt={title.trim()}
          width={localImage?.width}
          height={localImage?.height}
          class="project-image"
          loading="lazy"
          decoding="async"
        />
      )}
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )}
  <div class="project-copy">
    {category && <p class="project-category">{category}</p>}
    <h3>{title.trim()}</h3>
    <div class="project-description">
      {parsedDescription.map(html => <p set:html={html} />)}
    </div>
    {(link || github) && (
      <div class="link-row project-links">
        {link && <a href={link} target="_blank" rel="noopener noreferrer" class="text-link">View project <span aria-hidden="true">↗</span></a>}
        {github && <a href={github} target="_blank" rel="noopener noreferrer" class="text-link">Source code <span aria-hidden="true">↗</span></a>}
      </div>
    )}
  </div>
</article>

<style>
  .project-entry {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    align-items: start;
    gap: 2rem;
  }
  .project-entry + .project-entry { border-top: 1px solid var(--border); padding-top: 1.75rem; }
  .project-without-image { grid-template-columns: 1fr; }
  .project-figure { min-width: 0; max-width: 18rem; margin: 0; }
  .project-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 12rem;
    object-fit: contain;
    object-position: top left;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  figcaption { margin-top: 0.625rem; font-size: 0.75rem; line-height: 1.6; color: var(--muted-foreground); }
  .project-category { margin-bottom: 0.625rem; font-size: 0.8125rem; color: var(--muted-foreground); }
  .project-copy { min-width: 0; }
  h3 { font-size: 1.375rem; font-weight: 600; line-height: 1.3; margin-bottom: 0.75rem; }
  .project-description { max-width: 65ch; font-size: 0.9375rem; line-height: 1.65; }
  .project-description > p + p { margin-top: 0.5rem; }
  .project-description :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .project-links { margin-top: 0.75rem; }
  @media (max-width: 700px) {
    .project-entry { grid-template-columns: 1fr; gap: 1.25rem; }
    .project-figure { max-width: 16rem; }
    .project-image { max-height: 10rem; }
  }
</style>
