---
import Navigation from './Navigation';
---

<section id="hero" class="page-width" aria-labelledby="intro-heading">
  <div class="hero-grid">
    <div class="hero-content">
      <h1 id="intro-heading" class="ink-heading">I build tools for<br />working with data.</h1>
      <p class="hero-description">
        I am a principal software engineer at Posit, building a new AI-native Jupyter notebook experience for the Positron IDE.
      </p>
    </div>
    <aside class="hero-aside">
      <Navigation />
    </aside>
  </div>
</section>

<style>
  #hero {
    flex: 1;
    display: grid;
    align-items: center;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(11rem, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: 3rem 3.5rem;
  }
  h1 {
    width: fit-content;
    max-width: 100%;
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.04em;
  }
  .hero-description {
    max-width: 54ch;
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .hero-aside { border-left: 1px solid var(--rule); padding-left: 1.5rem; }
  @media (max-width: 700px) {
    .hero-grid { grid-template-columns: 1fr; gap: 1.75rem; padding-block: 2rem 2.75rem; }
    .hero-aside { border-left: 0; border-top: 1px solid var(--rule); padding: 1.25rem 0 0; }
    /* The contents ribbon replaces this list wherever it can open. */
    @supports selector(:popover-open) {
      .hero-aside { display: none; }
    }
  }
</style>
