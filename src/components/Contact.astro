---
import { SITE_CONFIG } from '../data/constants';
import Section from './Section.astro';
import SectionTitle from './SectionTitle.astro';
---

<Section id="contact">
  <SectionTitle>Get in touch</SectionTitle>
  <p class="contact-intro">I am always interested in getting involved in new projects or connecting with others. Feel free to reach out!</p>
  <div class="link-row contact-links">
    <a href={`mailto:${SITE_CONFIG.email}`} class="text-link">Email <span aria-hidden="true">↗</span></a>
    <a href="https://twitter.com/NicholasStrayer" target="_blank" rel="noopener noreferrer" class="text-link">Twitter <span aria-hidden="true">↗</span></a>
    <a href="https://github.com/nstrayer" target="_blank" rel="noopener noreferrer" class="text-link">GitHub <span aria-hidden="true">↗</span></a>
    <a href="https://linkedin.com/in/nickstrayer" target="_blank" rel="noopener noreferrer" class="text-link">LinkedIn <span aria-hidden="true">↗</span></a>
  </div>
</Section>

<style>
  .contact-intro { max-width: 62ch; }
  .contact-links { margin-top: 1.25rem; }
</style>
