---
import { PROJECTS } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import Section from './Section.astro';
import SectionTitle from './SectionTitle.astro';

const INITIAL_PROJECT_COUNT = 6;
const selectedProjects = PROJECTS.slice(0, INITIAL_PROJECT_COUNT);
const moreProjects = PROJECTS.slice(INITIAL_PROJECT_COUNT);
---

<Section id="projects">
  <SectionTitle>Selected work</SectionTitle>
  <div class="project-list">
    {selectedProjects.map(project => <ProjectCard {...project} />)}
  </div>
  {moreProjects.length > 0 && (
    <details class="more-projects">
      <summary class="text-link">
        <span class="when-closed">More projects <span aria-hidden="true">↓</span></span>
        <span class="when-open">Fewer projects <span aria-hidden="true">↑</span></span>
      </summary>
      <div class="project-list additional-projects">
        {moreProjects.map(project => <ProjectCard {...project} />)}
      </div>
    </details>
  )}
</Section>

<style>
  .project-list { display: grid; gap: 1.75rem; }
  .more-projects { margin-top: 2rem; }
  summary { width: fit-content; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .when-open, details[open] .when-closed { display: none; }
  details[open] .when-open { display: inline; }
  .additional-projects { margin-top: 2rem; }
</style>
