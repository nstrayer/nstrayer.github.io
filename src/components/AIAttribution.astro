---
interface Props {
  statement: string;
  tools: string[];
}

const { statement, tools } = Astro.props;
---

<aside class="ai-attribution" aria-labelledby="ai-attribution-title">
  <div class="attribution-heading">
    <h2 id="ai-attribution-title">AI assistance</h2>
    <span class="info-mark" aria-hidden="true">i</span>
  </div>
  <p>{statement}</p>
  <div class="tools-row">
    <span class="tools-label">Tools</span>
    <ul aria-label="AI tools used">
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
  </div>
</aside>

<style>
  .ai-attribution {
    margin-top: 4rem;
    background: var(--card);
    border: 1px solid color-mix(in oklch, var(--foreground) 65%, transparent);
  }

  .attribution-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.25rem 0;
  }

  h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .info-mark {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-family: 'Bitter', Georgia, serif;
    font-size: 0.72rem;
    font-weight: 700;
  }

  p {
    margin: 0;
    padding: 0.85rem 1.25rem 1.25rem;
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .tools-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1.25rem;
    border-top: 1px solid color-mix(in oklch, var(--foreground) 25%, transparent);
  }

  .tools-label {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-weight: 600;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.22rem 0.55rem;
    border: 1px solid var(--border);
    background: var(--background);
    font-size: 0.8rem;
  }
</style>
