---
interface Props {
  statement: string;
  tools: string[];
}

const { statement, tools } = Astro.props;
---

<aside class="ai-attribution" aria-labelledby="ai-attribution-title">
  <header class="attribution-heading">
    <h2 id="ai-attribution-title">How AI was used in the building of this post</h2>
  </header>
  <p>{statement}</p>
  <div class="tools-row">
    <span class="tools-label">Tools</span>
    <ul aria-label="AI tools used">
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
  </div>
</aside>

<style>
  .ai-attribution {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .attribution-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  h2 {
    margin: 0;
    font-size: 1rem;
  }

  p {
    margin: 0;
    padding-block: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .tools-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .tools-label {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-weight: 600;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    font-size: 0.8rem;
  }

  li + li::before {
    content: '·';
    margin-right: 0.5rem;
  }
</style>
