---
import { SKILL_GROUPS } from '../data/constants';
import Section from './Section.astro';
import SectionTitle from './SectionTitle.astro';
---

<Section id="skills">
  <SectionTitle>Tools &amp; methods</SectionTitle>
  <div class="skill-index">
    {SKILL_GROUPS.map(group => (
      <div>
        <h3>{group.title}</h3>
        <ul>{group.skills.map(skill => <li>{skill}</li>)}</ul>
      </div>
    ))}
  </div>
</Section>

<style>
  .skill-index { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  h3 { font-family: inherit; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.75rem; }
  ul { list-style: none; padding: 0; margin: 0; font-size: 0.9375rem; line-height: 1.85; color: var(--muted-foreground); }
  @media (max-width: 550px) { .skill-index { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
