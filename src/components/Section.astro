---
interface Props {
  id?: string;
  class?: string;
  containerClass?: string;
}

const { id, class: className = '', containerClass = '' } = Astro.props;
---

<!-- Automatic stacking lets the ink blend with the shared paper backdrop. -->
<section id={id} class={`page-section page-width ${className}`}>
  <div class={`section-inner ${containerClass}`}>
    <slot />
  </div>
</section>
