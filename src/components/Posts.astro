---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import SectionTitle from './SectionTitle.astro';
import PostCard from './PostCard.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<Section id="posts">
  <div class="posts-heading">
    <SectionTitle>Posts</SectionTitle>
    <a class="all-posts text-link" href="/posts/">View all posts <span aria-hidden="true">→</span></a>
  </div>
  <p class="intro">Short notes on software, data, visualization, and things learned along the way.</p>
  <div class="posts-list">
    {posts.map((post) => (
      <PostCard
        slug={post.id}
        title={post.data.title}
        description={post.data.description}
        publishedAt={post.data.publishedAt}
        tags={post.data.tags}
      />
    ))}
  </div>
</Section>

<style>
  :global(#posts) { padding-bottom: 4rem; }
  :global(#posts > .section-inner) { padding-top: 2rem; }

  .posts-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-bottom: 1rem;
  }

  .posts-heading :global(.section-title) { margin-bottom: 0; }

  .intro {
    max-width: 65ch;
    margin: 0 0 2rem;
    color: var(--muted-foreground);
  }

  .posts-list {
    max-width: 46rem;
  }

  .all-posts {
    white-space: nowrap;
  }
</style>
