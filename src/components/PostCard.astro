---
import { formatPostDate } from '../lib/posts';

interface Props {
  slug: string;
  title: string;
  description: string;
  publishedAt: Date;
  tags?: string[];
}

const { slug, title, description, publishedAt, tags = [] } = Astro.props;
---

<article class="post-card">
  <h3>
    <a href={`/posts/${slug}/`}>{title}</a>
  </h3>
  <p>{description}</p>
  <div class="post-meta">
    <time datetime={publishedAt.toISOString()}>{formatPostDate(publishedAt)}</time>
    {tags.length > 0 && <span aria-hidden="true">·</span>}
    {tags.length > 0 && <span>{tags.join(' · ')}</span>}
  </div>
</article>

<style>
  .post-card { padding-block: 1.25rem; }
  .post-card:first-child { padding-top: 0; }
  .post-card:last-child { padding-bottom: 0; }

  .post-card + .post-card {
    border-top: 1px solid var(--rule-faint);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: var(--text-caption);
  }

  h3 {
    margin: 0 0 0.375rem;
    font-size: var(--text-h3);
  }

  p {
    margin: 0;
    color: var(--muted-foreground);
  }

</style>
