---
import Section from './Section.astro';
import SectionTitle from './SectionTitle.astro';
---

<Section id="cv-resume">
  <SectionTitle>CV &amp; resume</SectionTitle>
  <div class="document-grid">
    <div>
      <h3>CV</h3>
      <p>A comprehensive list of my career accomplishments, publications, and experience.</p>
      <div class="link-row document-links">
        <a href="http://nickstrayer.me/cv" target="_blank" rel="noopener noreferrer" class="text-link">Read online <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/nstrayer/cv/raw/master/strayer_cv.pdf" target="_blank" rel="noopener noreferrer" class="text-link">Download PDF <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div>
      <h3>Resume</h3>
      <p>A concise single-page summary of my data science career.</p>
      <div class="link-row document-links">
        <a href="http://nickstrayer.me/cv/resume.html" target="_blank" rel="noopener noreferrer" class="text-link">Read online <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/nstrayer/cv/raw/master/strayer_resume.pdf" target="_blank" rel="noopener noreferrer" class="text-link">Download PDF <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
  <p class="document-note">Built with my own R package: <a href="https://github.com/nstrayer/cv" target="_blank" rel="noopener noreferrer">github.com/nstrayer/cv</a></p>
</Section>

<style>
  .document-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  h3 { font-size: 1.25rem; margin-bottom: 0.75rem; }
  .document-grid p { max-width: 42ch; font-size: 0.9375rem; line-height: 1.75; }
  .document-links { margin-top: 1rem; }
  .document-note { margin-top: 2rem; font-size: 0.8125rem; color: var(--muted-foreground); }
  .document-note a { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 550px) { .document-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
