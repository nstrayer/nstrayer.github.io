---
/** Posts as a dated list, like a printed contents page: date and tags in a narrow column, then title and description. */
import type { CollectionEntry } from 'astro:content';
import { formatPostDate } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<ul class="post-list" role="list">
  {posts.map(({ id, data }) => (
    <li>
      <article>
        <div class="post-meta">
          <time datetime={data.publishedAt.toISOString()}>{formatPostDate(data.publishedAt, 'short')}</time>
          {data.tags.length > 0 && <p class="tags">{data.tags.join(' · ')}</p>}
        </div>
        <div>
          <h3><a href={`/posts/${id}/`}>{data.title}</a></h3>
          <p>{data.description}</p>
        </div>
      </article>
    </li>
  ))}
</ul>

<style>
  .post-list {
    max-width: 46rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-faint);
  }

  li {
    border-bottom: 1px solid var(--rule-faint);
  }

  /* The list ends without a trailing rule. */
  li:last-child {
    border-bottom: none;
  }

  /* Date and tags share a narrow column, with the date on the title's baseline. */
  article {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    padding-block: 1.25rem;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    color: var(--muted-foreground);
    font-size: var(--text-caption);
    line-height: var(--leading-small);
  }

  time {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  h3 {
    margin: 0 0 0.375rem;
    font-size: var(--text-h3);
  }

  /* Titles read as headings at rest; the underline only confirms a hover. */
  h3 a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 150ms ease;
  }

  h3 a:hover {
    text-decoration-color: currentColor;
  }

  p {
    margin: 0;
    color: var(--muted-foreground);
  }

  /* Narrow screens stack the columns, so the tags join the date on one line. */
  @media (max-width: 600px) {
    article { grid-template-columns: minmax(0, 1fr); }
    .post-meta { flex-direction: row; flex-wrap: wrap; gap: 0 0.45rem; }
    .tags::before { content: '·'; margin-right: 0.45rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    h3 a { transition: none; }
  }
</style>
