---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { SITE_CONFIG } from '../../data/constants';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<Layout
  title={`Posts — ${SITE_CONFIG.name}`}
  description="Short notes on software, data, visualization, and things learned along the way."
>
  <main id="content" class="page-width">
    <div class="archive">
      <header class="page-header">
        <a class="text-link" href="/"><span aria-hidden="true">←</span> Home</a>
        <h1 class="ink-heading">Posts</h1>
        <p class="lede">Short notes on software, data, visualization, and things learned along the way.</p>
      </header>

      <section aria-label="All posts">
        {posts.length > 0 ? (
          <PostList posts={posts} />
        ) : (
          <p class="empty-state">No posts yet. Check back soon.</p>
        )}
      </section>
    </div>
  </main>
</Layout>

<style>
  main {
    position: relative;
    min-height: calc(100vh - 8rem);
    padding-block: 2rem 4rem;
  }

  /* The same centered reading column as a post page. */
  .archive {
    width: 100%;
    max-width: 45rem;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  h1 {
    margin: 1.5rem 0 0;
    font-size: var(--text-display);
    line-height: 1.12;
  }

  .lede {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    color: var(--muted-foreground);
    font-size: var(--text-large);
  }

  .empty-state {
    padding-top: 1.5rem;
    color: var(--muted-foreground);
  }
</style>
