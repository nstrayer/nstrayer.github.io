---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_CONFIG } from '../../data/constants';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<Layout
  title={`Posts — ${SITE_CONFIG.name}`}
  description="Short notes on software, data, visualization, and things learned along the way."
>
  <main id="content" class="page-width">
    <header class="page-header">
      <a class="text-link" href="/"><span aria-hidden="true">←</span> Home</a>
      <h1 class="ink-heading">Posts</h1>
      <p class="lede">Short notes on software, data, visualization, and things learned along the way.</p>
    </header>

    <section class="posts-list" aria-label="All posts">
      {posts.length > 0 ? (
        posts.map((post) => (
          <PostCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            publishedAt={post.data.publishedAt}
            tags={post.data.tags}
          />
        ))
      ) : (
        <p class="empty-state">No posts yet. Check back soon.</p>
      )}
    </section>
  </main>
</Layout>

<style>
  main {
    position: relative;
    min-height: calc(100vh - 8rem);
    padding-block: 2rem 4rem;
  }

  .page-header,
  .posts-list {
    width: 100%;
    max-width: 46rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  h1 {
    margin: 1.5rem 0 0;
    font-size: var(--text-display);
    line-height: 1.12;
  }

  .lede {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    color: var(--muted-foreground);
    font-size: var(--text-large);
  }

  .posts-list {
    border-top: 1px solid var(--rule);
    padding-top: 0.75rem;
  }

  .empty-state {
    padding-top: 1.5rem;
    color: var(--muted-foreground);
  }
</style>
