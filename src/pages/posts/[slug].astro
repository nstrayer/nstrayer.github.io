---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AIAttribution from '../../components/AIAttribution.astro';
import { SITE_CONFIG } from '../../data/constants';
import { formatPostDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, publishedAt, updatedAt, tags, ai } = post.data;
---

<Layout title={`${title} — ${SITE_CONFIG.name}`} description={description}>
  <main id="content" class="page-width">
    <article>
      <a class="text-link" href="/posts/"><span aria-hidden="true">←</span> All posts</a>

      <header class="post-header">
        <div class="post-meta">
          <time datetime={publishedAt.toISOString()}>{formatPostDate(publishedAt)}</time>
          {tags.length > 0 && <span aria-hidden="true">•</span>}
          {tags.length > 0 && <span>{tags.join(' · ')}</span>}
        </div>
        <h1 class="ink-heading">{title}</h1>
        <p>{description}</p>
        {updatedAt && (
          <p class="updated">Updated <time datetime={updatedAt.toISOString()}>{formatPostDate(updatedAt)}</time></p>
        )}
      </header>

      <div class="post-body">
        <Content />
      </div>

      {ai && <AIAttribution statement={ai.statement} tools={ai.tools} />}
    </article>
  </main>
</Layout>

<style>
  main {
    position: relative;
    min-height: calc(100vh - 8rem);
    padding-block: 2rem 4rem;
  }

  article {
    width: 100%;
    max-width: 45rem;
    margin: 0 auto;
  }

  .post-header {
    margin: 2rem 0 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  h1 {
    max-width: 42rem;
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.15;
  }

  .post-header > p:not(.updated) {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    color: var(--muted-foreground);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .updated {
    margin: 0.75rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    font-style: italic;
  }

  .post-body {
    color: var(--foreground);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol),
  .post-body :global(blockquote),
  .post-body :global(pre) {
    margin: 1.35rem 0;
  }

  .post-body :global(h2),
  .post-body :global(h3) {
    margin: 2.75rem 0 1rem;
    line-height: 1.25;
  }

  .post-body :global(h2) {
    font-size: 1.75rem;
  }

  .post-body :global(h3) {
    font-size: 1.35rem;
  }

  .post-body :global(a) {
    color: var(--foreground);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.4rem;
  }

  .post-body :global(li) {
    margin: 0.5rem 0;
    padding-left: 0.3rem;
  }

  .post-body :global(blockquote) {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
    color: var(--muted-foreground);
    font-family: 'Bitter', Georgia, serif;
    font-size: 1.12rem;
  }

  .post-body :global(code) {
    padding: 0.15em 0.35em;
    border: 1px solid var(--border);
    background: var(--card);
    font-size: 0.88em;
  }

  .post-body :global(pre) {
    overflow-x: auto;
    padding: 1.25rem;
    border: 1px solid var(--border);
    background: var(--card);
  }

  .post-body :global(pre code) {
    padding: 0;
    border: 0;
    background: transparent;
  }

  /* Typeset table: heavier rules above and below, hairlines between rows, no verticals. */
  .post-body :global(table) {
    width: max-content;
    max-width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    border-block: 1.5px solid var(--foreground);
    font-size: 0.94rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.45;
  }

  .post-body :global(th),
  .post-body :global(td) {
    padding: 0.5rem 1.25rem 0.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--foreground) 14%, transparent);
    text-align: left;
    vertical-align: top;
  }

  .post-body :global(th) {
    font-weight: 600;
  }

  .post-body :global(thead th) {
    border-bottom-color: var(--foreground);
  }

  .post-body :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .post-body :global(th:last-child),
  .post-body :global(td:last-child) {
    padding-right: 0;
  }

  .post-body :global(th[align='right']),
  .post-body :global(td[align='right']) {
    text-align: right;
  }

  .post-body :global(table code) {
    white-space: nowrap;
  }

  .post-body :global(caption) {
    caption-side: bottom;
    padding: 0.7rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.82rem;
    line-height: 1.5;
    text-align: left;
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    margin: 2rem 0;
    border: 1px solid var(--border);
  }

  .post-body :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .post-body :global(table) {
      display: block;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
    }

    .post-body :global(th),
    .post-body :global(td) {
      padding-right: 1rem;
    }
  }
</style>
